# Match strech-dispatch-api EDGE_BEARER_TOKEN / ACTOR_JWT_SECRET
STRECH_DISPATCH_BASE_URL=http://localhost:3001/v1
STRECH_EDGE_BEARER_TOKEN=replace-me-edge-secret
STRECH_ACTOR_JWT_SECRET=replace-me-hs256-secret

# Dev gate for minting role=ops (never use member Bobo cookies)
OPS_DEV_TOKEN=replace-me-ops-dev-token
# Must be a UUID (job_events.actor_id / idempotency actor_id)
OPS_OPERATOR_SUB=00000000-0000-4000-8000-0000000000aa

# Field portal (/field) — defaults to OPS_DEV_TOKEN if unset
# FIELD_DEV_TOKEN=replace-me-field-dev-token
