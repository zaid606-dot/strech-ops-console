# ── Ops desk lock (required on Vercel) ──────────────────────────
# Share only with trusted operators. Password must be ≥12 characters.
OPS_DASHBOARD_USER=ops
OPS_DASHBOARD_PASSWORD=replace-with-long-shared-secret

# Signs session cookies (HMAC). Defaults to OPS_DASHBOARD_PASSWORD if unset.
# Prefer a dedicated secret in production.
# OPS_SESSION_SECRET=replace-with-another-long-secret

# Must be a UUID (job_events.actor_id / idempotency actor_id)
OPS_OPERATOR_SUB=00000000-0000-4000-8000-0000000000aa

# Field portal — defaults to OPS_DASHBOARD_PASSWORD if unset
# FIELD_DASHBOARD_PASSWORD=replace-with-field-secret

# ── Dispatch API (Stages 2+) ────────────────────────────────────
# Match strech-dispatch-api EDGE_BEARER_TOKEN / ACTOR_JWT_SECRET
STRECH_DISPATCH_BASE_URL=http://localhost:3001/v1
STRECH_EDGE_BEARER_TOKEN=replace-me-edge-secret
STRECH_ACTOR_JWT_SECRET=replace-me-hs256-secret
